# Kexra（科巡）开发环境配置
# Docker 镜像尚未发布，先用源码构建本地 kexra:local。
# 原 ARTEX_* 环境变量为兼容旧数据而保留，勿擅自清空生产配置。
KEXRA_IMAGE=kexra:local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
